# Copy to a secret environment store or an ignored .env.production file.
DJANGO_ENV=production
DJANGO_DEBUG=false
SECRET_KEY=replace-with-at-least-50-random-characters
DJANGO_ALLOWED_HOSTS=example.com,www.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
DJANGO_SECURE_HSTS_PRELOAD=false
DJANGO_TRUST_PROXY_HEADERS=false
DJANGO_LOG_LEVEL=INFO

DEFAULT_FROM_EMAIL=no-reply@example.com
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10

DB_ENGINE=mysql
DB_NAME=ai_thinking
DB_USER=ai_thinking_user
DB_PASSWORD=replace-with-a-unique-database-password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_CONN_MAX_AGE=60

GEMINI_API_KEY=
AI_PROVIDER_CLASS=
GEMINI_MODEL=gemini-2.5-flash
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_SECONDS=20
CODE_RUNNER_URL=https://runner.internal.example
CODE_RUNNER_AUTH_TOKEN=replace-with-a-unique-runner-token
CODE_RUNNER_TIMEOUT_SECONDS=20
